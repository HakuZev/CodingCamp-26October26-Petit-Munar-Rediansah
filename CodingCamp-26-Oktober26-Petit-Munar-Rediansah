<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Life Dashboard</title>
    <style>
        :root {
            --bg-color: #6c5ce7;
            --card-bg: #ffffff;
            --text-color: #2d3436;
            --subtext-color: #636e72;
            --accent-color: #a29bfe;
            --btn-bg: #6c5ce7;
            --btn-text: #ffffff;
            --border-color: #dfe6e9;
        }

        [data-theme="dark"] {
            --bg-color: #1e1e2e;
            --card-bg: #2d2d44;
            --text-color: #f8f8f2;
            --subtext-color: #a6adc8;
            --accent-color: #bb9af7;
            --btn-bg: #7aa2f7;
            --btn-text: #1a1b26;
            --border-color: #44475a;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            transition: background-color 0.3s, color 0.3s;
        }

        body {
            background-color: var(--bg-color);
            color: var(--text-color);
            min-height: 100vh;
            padding: 2rem;
            display: flex;
            justify-content: center;
        }

        .dashboard {
            width: 100%;
            max-width: 900px;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1.5rem;
        }

        .card {
            background-color: var(--card-bg);
            padding: 1.5rem;
            border-radius: 12px;
            box-shadow: 0 8px 16px rgba(0, 0, 0, 0.1);
            display: flex;
            flex-direction: column;
            gap: 1rem;
        }

        .full-width {
            grid-column: span 2;
        }

        header {
            text-align: center;
            position: relative;
        }

        .theme-toggle {
            position: absolute;
            right: 0;
            top: 0;
            background: transparent;
            border: none;
            font-size: 1.5rem;
            cursor: pointer;
        }

        .clock {
            font-size: 2.5rem;
            font-weight: bold;
            color: var(--btn-bg);
        }

        .date-display {
            font-size: 1rem;
            color: var(--subtext-color);
        }

        .greeting {
            font-size: 1.5rem;
            margin-top: 0.5rem;
        }

        .name-input {
            border: none;
            border-bottom: 2px dashed var(--subtext-color);
            background: transparent;
            color: var(--text-color);
            font-size: 1.5rem;
            font-weight: bold;
            width: 180px;
            text-align: center;
            outline: none;
        }

        h3 {
            font-size: 1.2rem;
            color: var(--text-color);
            border-bottom: 2px solid var(--border-color);
            padding-bottom: 0.5rem;
        }

        .timer-display {
            font-size: 3.5rem;
            font-weight: bold;
            text-align: center;
            color: var(--btn-bg);
            margin: 0.5rem 0;
        }

        .btn-group {
            display: flex;
            gap: 0.5rem;
            justify-content: center;
        }

        button {
            padding: 0.5rem 1rem;
            border: none;
            border-radius: 6px;
            background-color: var(--btn-bg);
            color: var(--btn-text);
            font-weight: bold;
            cursor: pointer;
        }

        button:hover {
            opacity: 0.9;
        }

        .btn-danger {
            background-color: #ff7675;
            color: #fff;
        }

        .input-group {
            display: flex;
            gap: 0.5rem;
        }

        input[type="text"], input[type="url"] {
            flex: 1;
            padding: 0.5rem;
            border: 1px solid var(--border-color);
            border-radius: 6px;
            background-color: var(--card-bg);
            color: var(--text-color);
            outline: none;
        }

        ul {
            list-style: none;
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
            max-height: 200px;
            overflow-y: auto;
        }

        li {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0.5rem;
            background-color: rgba(0, 0, 0, 0.03);
            border-radius: 6px;
        }

        .task-info {
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .completed {
            text-decoration: line-through;
            color: var(--subtext-color);
        }

        .quick-links-grid {
            display: flex;
            flex-wrap: wrap;
            gap: 0.5rem;
            margin-top: 0.5rem;
        }

        .link-chip {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            background-color: var(--accent-color);
            color: #fff;
            padding: 0.4rem 0.8rem;
            border-radius: 20px;
            text-decoration: none;
            font-size: 0.9rem;
        }

        .link-chip button {
            background: transparent;
            border: none;
            color: #fff;
            cursor: pointer;
            font-size: 0.8rem;
            padding: 0;
        }

        @media (max-width: 600px) {
            .dashboard {
                grid-template-columns: 1fr;
            }
            .full-width {
                grid-column: span 1;
            }
        }
    </style>
</head>
<body>

<div class="dashboard">
    <!-- Header & Greeting Card -->
    <div class="card full-width">
        <header>
            <button class="theme-toggle" id="themeToggle">🌙</button>
            <div class="clock" id="clock">00:00:00</div>
            <div class="date-display" id="dateDisplay">Monday, Jan 1, 2026</div>
            <div class="greeting">
                <span id="greetingText">Good Morning</span>, 
                <input type="text" id="usernameInput" class="name-input" placeholder="Your Name">
            </div>
        </header>
    </div>

    <!-- Focus Timer Card -->
    <div class="card">
        <h3>Focus Timer</h3>
        <div class="timer-display" id="timerDisplay">25:00</div>
        <div class="btn-group">
            <button id="startTimerBtn">Start</button>
            <button id="stopTimerBtn">Stop</button>
            <button id="resetTimerBtn">Reset</button>
        </div>
    </div>

    <!-- To-Do List Card -->
    <div class="card">
        <h3>Tasks</h3>
        <form id="taskForm" class="input-group">
            <input type="text" id="taskInput" placeholder="Add a new task..." required>
            <button type="submit">Add</button>
        </form>
        <ul id="taskList"></ul>
    </div>

    <!-- Quick Links Card -->
    <div class="card full-width">
        <h3>Quick Links</h3>
        <form id="linkForm" class="input-group">
            <input type="text" id="linkNameInput" placeholder="Link Name (e.g. Google)" required>
            <input type="url" id="linkUrlInput" placeholder="URL (e.g. https://google.com)" required>
            <button type="submit">Add Link</button>
        </form>
        <div class="quick-links-grid" id="linksContainer"></div>
    </div>
</div>

<script>
    // --- 1. CLOCK & GREETING ---
    const clockEl = document.getElementById('clock');
    const dateDisplayEl = document.getElementById('dateDisplay');
    const greetingTextEl = document.getElementById('greetingText');
    const usernameInput = document.getElementById('usernameInput');

    function updateClock() {
        const now = new Date();
        clockEl.textContent = now.toLocaleTimeString('en-US', { hour12: false });
        
        const options = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };
        dateDisplayEl.textContent = now.toLocaleDateString('en-US', options);

        const hours = now.getHours();
        if (hours < 12) greetingTextEl.textContent = 'Good Morning';
        else if (hours < 18) greetingTextEl.textContent = 'Good Afternoon';
        else greetingTextEl.textContent = 'Good Evening';
    }
    setInterval(updateClock, 1000);
    updateClock();

    // Challenge 1: Custom Name in Greeting
    usernameInput.value = localStorage.getItem('dashboard_username') || '';
    usernameInput.addEventListener('input', (e) => {
        localStorage.setItem('dashboard_username', e.target.value);
    });

    // --- 2. THEME TOGGLE (Challenge 2) ---
    const themeToggleBtn = document.getElementById('themeToggle');
    const savedTheme = localStorage.getItem('dashboard_theme') || 'light';
    document.documentElement.setAttribute('data-theme', savedTheme);
    themeToggleBtn.textContent = savedTheme === 'dark' ? '☀️' : '🌙';

    themeToggleBtn.addEventListener('click', () => {
        const currentTheme = document.documentElement.getAttribute('data-theme');
        const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', newTheme);
        localStorage.setItem('dashboard_theme', newTheme);
        themeToggleBtn.textContent = newTheme === 'dark' ? '☀️' : '🌙';
    });

    // --- 3. FOCUS TIMER ---
    let timerSeconds = 25 * 60;
    let timerInterval = null;
    const timerDisplay = document.getElementById('timerDisplay');

    function renderTimer() {
        const mins = Math.floor(timerSeconds / 60).toString().padStart(2, '0');
        const secs = (timerSeconds % 60).toString().padStart(2, '0');
        timerDisplay.textContent = `${mins}:${secs}`;
    }

    document.getElementById('startTimerBtn').addEventListener('click', () => {
        if (!timerInterval) {
            timerInterval = setInterval(() => {
                if (timerSeconds > 0) {
                    timerSeconds--;
                    renderTimer();
                } else {
                    clearInterval(timerInterval);
                    timerInterval = null;
                    alert('Time is up!');
                }
            }, 1000);
        }
    });

    document.getElementById('stopTimerBtn').addEventListener('click', () => {
        clearInterval(timerInterval);
        timerInterval = null;
    });

    document.getElementById('resetTimerBtn').addEventListener('click', () => {
        clearInterval(timerInterval);
        timerInterval = null;
        timerSeconds = 25 * 60;
        renderTimer();
    });

    // --- 4. TO-DO LIST (Local Storage & Challenge 3: Prevent Duplicates) ---
    const taskForm = document.getElementById('taskForm');
    const taskInput = document.getElementById('taskInput');
    const taskList = document.getElementById('taskList');
    let tasks = JSON.parse(localStorage.getItem('dashboard_tasks')) || [];

    function saveAndRenderTasks() {
        localStorage.setItem('dashboard_tasks', JSON.stringify(tasks));
        taskList.innerHTML = '';
        tasks.forEach((task, index) => {
            const li = document.createElement('li');
            li.innerHTML = `
                <div class="task-info">
                    <input type="checkbox" ${task.completed ? 'checked' : ''} onchange="toggleTask(${index})">
                    <span class="${task.completed ? 'completed' : ''}">${task.text}</span>
                </div>
                <button class="btn-danger" onclick="deleteTask(${index})">Delete</button>
            `;
            taskList.appendChild(li);
        });
    }

    taskForm.addEventListener('submit', (e) => {
        e.preventDefault();
        const text = taskInput.value.trim();
        if (!text) return;

        // Challenge: Prevent Duplicates
        const isDuplicate = tasks.some(t => t.text.toLowerCase() === text.toLowerCase());
        if (isDuplicate) {
            alert('Task already exists!');
            return;
        }

        tasks.push({ text, completed: false });
        taskInput.value = '';
        saveAndRenderTasks();
    });

    window.toggleTask = (index) => {
        tasks[index].completed = !tasks[index].completed;
        saveAndRenderTasks();
    };

    window.deleteTask = (index) => {
        tasks.splice(index, 1);
        saveAndRenderTasks();
    };

    saveAndRenderTasks();

    // --- 5. QUICK LINKS (Local Storage) ---
    const linkForm = document.getElementById('linkForm');
    const linkNameInput = document.getElementById('linkNameInput');
    const linkUrlInput = document.getElementById('linkUrlInput');
    const linksContainer = document.getElementById('linksContainer');
    let links = JSON.parse(localStorage.getItem('dashboard_links')) || [
        { name: 'Google', url: 'https://google.com' },
        { name: 'Gmail', url: 'https://mail.google.com' }
    ];

    function saveAndRenderLinks() {
        localStorage.setItem('dashboard_links', JSON.stringify(links));
        linksContainer.innerHTML = '';
        links.forEach((link, index) => {
            const chip = document.createElement('div');
            chip.className = 'link-chip';
            chip.innerHTML = `
                <a href="${link.url}" target="_blank" style="color:white; text-decoration:none;">${link.name}</a>
                <button onclick="deleteLink(${index})">✕</button>
            `;
            linksContainer.appendChild(chip);
        });
    }

    linkForm.addEventListener('submit', (e) => {
        e.preventDefault();
        const name = linkNameInput.value.trim();
        let url = linkUrlInput.value.trim();
        if (!url.startsWith('http://') && !url.startsWith('https://')) {
            url = 'https://' + url;
        }
        links.push({ name, url });
        linkNameInput.value = '';
        linkUrlInput.value = '';
        saveAndRenderLinks();
    });

    window.deleteLink = (index) => {
        links.splice(index, 1);
        saveAndRenderLinks();
    };

    saveAndRenderLinks();
</script>
</body>
</html>